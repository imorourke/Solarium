#include cbos_defs.cb

fn main(state: *k_exec_state_t, argv: **u8, argc: u32) i32 {
    if ((argc != 2) || (strcmp(argv[1], "--help") == 0) || (strcmp(argv[1], "-h") == 0)) {
        k_io_print(argv[0]);
        k_io_print(" [file]\n\n");
        k_io_print("  ");
        k_io_print(argv[0]);
        k_io_print(" reads the input file and types the results into the terminal\n\n");
        k_io_print("  -h : prints this help entry\n");
        if (argc == 2) {
            return 0;
        } else {
            return -1;
        }
    }

    def target: i32 = k_exec_fs_readlink(state, argv[1], K_FS_ENTRY_TYPE_FILE);
    if (target <= 0) {
        k_io_print("unable to find file for '");
        k_io_print(argv[1]);
        k_io_print("'\n");
        return -1;
    }

    def read_state: k_exec_fs_io_state_t;
    if (k_exec_fs_io_state_init(state, target : u16, 0, 0, &read_state) >= 0) {
        // Add one to the data size for null character in the array
        const DATA_SIZE: u32 = 128;
        def run_data: [DATA_SIZE + 1]u8;
        def read_size: u32 = DATA_SIZE;

        while (k_exec_fs_io_state_read_next_section(&read_state, &run_data, &read_size) > 0) {
            // Add the null character to the end
            run_data[read_size] = 0;

            // Ensure that there is enough space in the output buffer before printing
            while ((k_io_serial_output_size() : u32) + read_size > 65535) {}
            k_io_print(&run_data);

            read_size = DATA_SIZE;
        }
        k_io_print("\n");
    }

    return 0;
}
