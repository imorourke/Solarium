#include cbos_defs.cb

fn main(argv: **u8, argc: u32) i32 {
    k_io_print("Num args: ");
    k_io_print_uint(argc);
    k_io_print("\n");

    def i: u32 = 0;
    while (i < argc) {
        k_io_print("arg[");
        k_io_print_uint_width(i, 2);
        k_io_print("] = \"");
        k_io_print(argv[i]);
        k_io_print("\"\n");
        i = i + 1;
    }

    return 0;
}
