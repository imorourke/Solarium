#include <cbapp.cb>

fn print_results(loc: k_fs_entry_id_t, offset: u32, data_size: u32) i32;

fn main(argv: **u8, argc: u32) i32 {
    if ((argc != 2) || (strcmp(argv[1], "-h") == 0)) {
        k_io_print(argv[0]);
        k_io_print(" [file]\n\n");
        k_io_print("  ");
        k_io_print(argv[0]);
        k_io_print(" prints imports and exports present within a file\n\n");
        k_io_print("  -h : prints this help entry\n");
        if (argc == 2) {
            return 0;
        } else {
            return -1;
        }
    }

    def hdr: k_exec_hdr_t;
    memset(&hdr, 0, sizeof(hdr));
    def hdr_size: u32 = sizeof(hdr);

    def path: *u8 = argv[1];
    def loc: k_fs_entry_id_t;
    def res: i32 = readlink(path, K_FS_ENTRY_TYPE_FILE, &loc);
    if (res != 0) {
        k_io_print("unable to find file for ");
        k_io_print(path);
        k_io_print("\n");
        return -1;
    }

    if (0 != k_fs_file_read(loc, 0, &hdr_size, &hdr)) {
        k_io_print("unable to read ");
        k_io_print(argv[1]);
        k_io_print("\n");
        return -1;
    }

    k_io_print("Header:\n");
    k_io_print("  magic_num: 0x");
    k_io_print_hex(hdr.magic_num);
    k_io_print(" (");
    def i: i32 = 0;
    def base: *u8 = &hdr.magic_num;
    while (i < sizeof(u32)) {
        k_io_put(*(base + i));
        i = i + 1;
    }
    k_io_print(")\n");
    k_io_print_stat("  import_offset", hdr.import_offset);
    k_io_print_stat("  import_size", hdr.import_size);
    k_io_print_stat("  export_offset", hdr.export_offset);
    k_io_print_stat("  export_size", hdr.export_size);
    k_io_print_stat("  prog_offset", hdr.prog_offset);
    k_io_print_stat("  prog_size", hdr.prog_size);
    k_io_print_stat("  attribute", hdr.attribute);

    if (hdr.magic_num != K_EXEC_MAGIC_HDR) {
        k_io_print("unknown executable format found\n");
        return -1;
    }

    k_io_print("Imports:\n");
    if (print_results(loc, hdr.import_offset, hdr.import_size) != 0) {
        return -1;
    }

    k_io_print("Exports:\n");
    if (print_results(loc, hdr.export_offset, hdr.export_size) != 0) {
        return -1;
    }

    return 0;
}

fn print_results(loc: k_fs_entry_id_t, offset: u32, data_size: u32) i32 {
    if (data_size > 0) {
        def data: *u8 = malloc(data_size);
        memset(data, 0, data_size);
        if (data == NULL) {
            k_io_print("unable to create link data table\n");
            return -1;
        }

        if (0 != k_fs_file_read(loc, offset, &data_size, data)) {
            k_io_print("unable to read link table\n");
            free(data);
            return -1;
        }

        // Read the link data and apply
        def current_loc: *u8 = data;
        def end_loc: *u8 = data + data_size;
        def res: i32 = 0;

        while (current_loc < end_loc) {
            def rgn: *k_link_rgn_t = current_loc;
            current_loc = current_loc + sizeof(k_link_rgn_t);

            def name: *u8 = current_loc;
            current_loc = current_loc + rgn->name_size;

            k_io_print("  ");
            k_io_print(name);
            k_io_print(": 0x");
            k_io_print_hex(rgn->offset);
            k_io_print("\n");

            if (k_exec_should_exit()) {
                res = -1;
                break;
            }
        }

        free(data);
        return res;
    } else {
        return -1;
    }
}
