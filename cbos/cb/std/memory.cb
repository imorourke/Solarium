#ifndef STD_MEMORY
#define STD_MEMORY

#include <kernel/kdef.cb>
#include <kernel/kmalloc.cb>
#include <kernel/kexec.cb>

export fn free(ptr: *u8) void {
    k_free(ptr);
}

export fn memset(dst: *u8, val: u8, size: u32) void {
    k_memset(dst, val, size);
}

export fn memcpy(dst: *u8, src: *u8, size: u32) void {
    k_memcpy(dst, src, size);
}

#endif
