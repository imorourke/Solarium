#ifndef K_CONFIG
#define K_CONFIG

#include kdef.cb

const K_LOC_DEVICE_START: u32 = 0xFFFFA000u32;
const K_LOC_DEVICE_HD_START: u32 = 0xFFFFB000u32;

const K_MEM_SIZE: u32 = 0x10000u32;
const K_MEM_START: *u8 = 0x1000000u32;

#ifdef K_OS_VER
global K_OS_VERSION: *u8 = "${K_OS_VER}";
#else
global K_OS_VERSION: *u8 = "?";
#endif

#endif // K_CONFIG
