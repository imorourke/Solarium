#ifndef K_LINK
#define K_LINK

#include kdef.cb
#include kfs.cb
#include kserialio.cb
#include <std/list.cb>
#include <std/string.cb>

export struct k_exec_hdr_t {
    magic_num: u32;
    import_offset: u32;
    import_size: u32;
    export_offset: u32;
    export_size: u32;
    prog_offset: u32;
    prog_size: u32;
    attribute: u32;
}

export const K_EXEC_MAGIC_HDR: u32 = 0x43424150;
export const K_SHELL_MAGIC_HDR: u32 = 0x23217368;

export struct k_link_rgn_t {
    data_size: u8;
    name_size: u8;
    offset: u32;
}

import global K_LINK_EXPORT_DATA: *u8 = 0;
import global K_LINK_EXPORT_SIZE: u32 = 0;

// Returns an executable location, or null if there is no location
// for the requested symbol
fn k_link_get_addr(symbol: *u8) u32 {
    def current_loc: *u8 = K_LINK_EXPORT_DATA;
    def end_loc: *u8 = K_LINK_EXPORT_DATA + K_LINK_EXPORT_SIZE;
    while (current_loc < end_loc) {
        def rgn: *k_link_rgn_t = current_loc;
        current_loc = current_loc + sizeof(k_link_rgn_t);

        def name: *u8 = current_loc;

        if (strcmp(symbol, name) == 0) {
            return rgn->offset;
        }

        current_loc = current_loc + rgn->name_size;
    }

    return 0;
}

// Returns an executable location, or null if there is no location
// for the requested symbol
fn k_link_print_exports() u32 {
    def current_loc: *u8 = K_LINK_EXPORT_DATA;
    def end_loc: *u8 = K_LINK_EXPORT_DATA + K_LINK_EXPORT_SIZE;
    while (current_loc < end_loc) {
        def rgn: *k_link_rgn_t = current_loc;
        current_loc = current_loc + sizeof(k_link_rgn_t);

        def name: *u8 = current_loc;
        k_io_print(name);
        k_io_print(": ");
        k_io_print_hex(rgn->offset);
        k_io_print("\n");

        current_loc = current_loc + rgn->name_size;
    }

    return 0;
}

#endif // K_LINK
