#ifndef K_RTC_DEV
#define K_RTC_DEV

#include kconfig.cb
#include kdevice.cb
#include kserialio.cb
#include kmalloc.cb

export struct k_datetime_t {
    year: i16;
    month: u8;
    day: u8;
    hour: u8;
    minute: u8;
    second: u8;
    hundredths: u8;
}

struct k_rtc_control_t {
    device_id: u16;
    datetime: k_datetime_t;
}

struct k_rtc_timer_t {
    device_id: u16;
    irq: u8;
    repeats: u8;
    msec: u32;
}

global K_RTC_BASE: *k_rtc_control_t = 0;
global K_RTC_TIMER: *k_rtc_timer_t = 0;

fn k_rtc_init() void {
    def dev: *k_device_t = 0;

    dev = k_device_first_of_type(K_DEVICE_ID_RTC_CLOCK);
    if (dev != 0) {
        K_RTC_BASE = dev->data;
    } else {
        K_RTC_BASE = 0;
    }

    dev = k_device_first_of_type(K_DEVICE_ID_RTC_TIMER);
    if (dev != 0) {
        K_RTC_TIMER = dev->data;
    } else {
        K_RTC_TIMER = 0;
    }
}

export fn k_rtc_current() k_datetime_t {
    if (K_RTC_BASE != 0) {
        return K_RTC_BASE->datetime;
    } else {
        def temp: k_datetime_t;
        k_memset(&temp, 0, sizeof(temp));
        return temp;
    }
}

export fn k_print_date(dt: *k_datetime_t) void {
    k_io_print_uint_width(dt->year, 4);
    k_io_print("-");
    k_io_print_uint_width(dt->month, 2);
    k_io_print("-");
    k_io_print_uint_width(dt->day + 1, 2);
    k_io_print(" ");
    k_io_print_uint_width(dt->hour, 2);
    k_io_print(":");
    k_io_print_uint_width(dt->minute, 2);
    k_io_print(":");
    k_io_print_uint_width(dt->second, 2);
}

#endif // K_RTC_DEV
