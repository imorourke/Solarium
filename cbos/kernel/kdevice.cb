#ifndef K_DEVICE
#define K_DEVICE

#include kconfig.cb
#include kerr.cb
#include kmalloc.cb

const K_DEVICE_SIZE: u32 = 32;
const K_DEVICE_COUNT: u32 = 128;

const K_DEVICE_ID_SERIALIO: u16 = 1;
const K_DEVICE_ID_IRQ_CLOCK: u16 = 2;
const K_DEVICE_ID_RTC_CLOCK: u16 = 3;
const K_DEVICE_ID_RTC_TIMER: u16 = 4;

struct k_device_t {
    slot: u16;
    id: u16;
    data: *u8;
}

global K_DEVICE_TABLE: [K_DEVICE_COUNT]k_device_t;
global K_DEVICE_NUM: u32 = 0;

fn k_device_init(all: u8) void {
    k_memset(&K_DEVICE_TABLE, 0, sizeof(k_device_t) * K_DEVICE_COUNT);
    def dev: *u8 = K_LOC_DEVICE_START;
    def i: u32 = 0;
    K_DEVICE_NUM = 0;
    while (i < K_DEVICE_COUNT) {
        def id: u16 = *(dev : *u16);
        if (id != 0) {
            K_DEVICE_TABLE[K_DEVICE_NUM].slot = i;
            K_DEVICE_TABLE[K_DEVICE_NUM].id = id;
            K_DEVICE_TABLE[K_DEVICE_NUM].data = dev;
            K_DEVICE_NUM += 1;
        } else {
            break;
        }
        dev = dev + K_DEVICE_SIZE;
        i += 1;
    }
}

fn k_device_first_of_type(type_id: u16) *k_device_t {
    if (type_id == 0) {
        return 0;
    }

    def i: u32 = 0;
    while (i < K_DEVICE_NUM) {
        if (K_DEVICE_TABLE[i].id == type_id) {
            return &(K_DEVICE_TABLE[i]);
        }
        i += 1;
    }

    return 0;
}

struct k_device_pram_t {
    id: u16;
    boot_debug: u8;
}

const K_DEVICE_ID_PRAM_SETTINGS: u16 = 100;

fn k_device_pram_settings() k_device_pram_t {
    def settings: k_device_pram_t;
    k_memset(&settings, 0, sizeof(settings));
    def dev: *k_device_t = k_device_first_of_type(K_DEVICE_ID_PRAM_SETTINGS);
    if (dev != NULL) {
        settings = *((dev->data) : *k_device_pram_t);
    }
    return settings;
}

fn k_device_pram_settings_set(vals: *k_device_pram_t) i32 {
    def dev: *k_device_t = k_device_first_of_type(K_DEVICE_ID_PRAM_SETTINGS);
    if (!dev) {
        return K_ERR_DEV_UNKNOWN;
    } else if (!vals) {
        return K_ERR_INVALID_ARG;
    } else {
        def settings: *k_device_pram_t = dev->data;
        settings->boot_debug = vals->boot_debug;
        return K_SUCCESS;
    }
}

#endif // K_DEVICE
