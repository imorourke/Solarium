#ifndef K_SHELL
#define K_SHELL

#include kcpu.cb
#include kdbg.cb
#include kfs.cb
#include klink.cb
#include kmalloc.cb
#include kmalloc_dbg.cb
#include kserialio.cb

const K_SHELL_DEFAULT_INPUT_BUFFER_SIZE: u32 = 128;
const K_SHELL_DEFAULT_ARG_SPLIT_SIZE: u32 = 8;

struct k_shell_state_t {
    fs: k_fs_entry_id_t;
    path: [K_DISK_NUM_MOUNTS]u16;
    auto_halt: u8;
}

fn k_shell_run_cmd(state: *k_shell_state_t, argv: **u8, argc: i32) i32;

fn k_shell_fn_help(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_io_print("CB/OS v");
    k_io_print(K_OS_VERSION);
    k_io_print("\n");
    k_io_print("Supported Commands:\n");
    k_io_print("  ? / help      -> shows this help command\n");
    k_io_print("  date          -> shows the current date/time\n");
    k_io_print("  dbg           -> prints current debug output status\n");
    k_io_print("  dbg [on/off]  -> enables/disables debug output\n");
    k_io_print("  mem           -> shows the current heap allocations\n");
    k_io_print("  mount         -> mounts the current disk\n");
    k_io_print("  umount        -> umounts the current disk\n");
    k_io_print("  reset         -> resets the processor\n");
    k_io_print("  pwd           -> prints the current directory\n");
    k_io_print("  ls [dir]      -> lists entries in the current (or provided) directory\n");
    k_io_print("  exports       -> lists symbols exported from the current OS\n");
    k_io_print("  run [file]    -> executes the binary, or if a script, the script text\n");
    k_io_print("                   file provided by the given argument. Scripts are run\n");
    k_io_print("                   with each line of the file provided as if it were typed\n");
    k_io_print("                   into the console as a script\n");
    k_io_print("  cd [file/dir] -> changes directory to the provided folder\n");
    k_io_print("                   or parent directory if '..' provided\n");
    k_io_print("  reset         -> resets the processor\n");
    k_io_print("  halt          -> halts the CPU\n");
    k_io_print("  halt [on/off] -> turns on/off auto-halt\n");
    return 0;
}

fn k_shell_fn_ls(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def target_dir: k_fs_entry_id_t;

    if (argc < 2) {
        target_dir = state->fs;
    } else if (argc == 2) {
        def res: i32 = k_fs_readlink(argv[1], K_FS_ENTRY_TYPE_DIR, &state->fs, &target_dir);
        if (0 != res) {
            k_io_print("unable to find path for '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return res;
        }
    } else {
        k_io_print("unexpected number of arguments provided for ls\n");
        return -1;
    }

    const ENTRY_SIZE_LIM: u32 = 10;
    def test_entries: [ENTRY_SIZE_LIM]k_fs_directory_entry_t;
    def test_entry_size: u32 = ENTRY_SIZE_LIM;

    def res: i32 = k_fs_read_directory_entries(target_dir, &test_entries, &test_entry_size, 0);
    if (res == 0) {
        def ii: u32 = 0;
        def name_tmp: [K_FS_ENTRY_NAME_LEN+1]u8;
        k_memset(&name_tmp, 0, K_FS_ENTRY_NAME_LEN + 1);
        while (ii < test_entry_size) {
            def ent: *k_fs_directory_entry_t = &test_entries[ii];
            k_memcpy(&name_tmp, &(ent->name), K_FS_ENTRY_NAME_LEN);
            if (ent->entry_type == K_FS_ENTRY_TYPE_FILE) {
                if (ent->attributes & K_FS_ATTRIBUTE_EXECUTABLE) {
                    k_io_print("f:* ");
                } else {
                    k_io_print("f:  ");
                }
                k_io_print(name_tmp);
                k_io_print("\n");
            } else if (ent->entry_type == K_FS_ENTRY_TYPE_DIR) {
                k_io_print("d:  ");
                k_io_print(name_tmp);
                k_io_print("/\n");
            } else {
                k_io_print("?:  ");
                k_io_print(name_tmp);
                k_io_print("\n");
            }
            ii = ii + 1;
        }
        return 0;
    } else {
        k_io_print("Error getting entries\n  ");
        k_io_print_int(res);
        k_io_print("\n");
        return -1;
    }
}

fn k_shell_fn_cd(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    if (argc < 2) {
        if (state->fs.disk_index >= 0) {
            def disk: *k_disk_fs_t = k_disk_get(state->fs.disk_index);
            if (disk != NULL) {
                state->fs.entry = disk->vol_hdr.root_sector;
            } else {
                state->fs.entry = 0;
                return -1;
            }
        } else {
            state->fs.entry = 0;
        }
        return 0;
    } else if (argc == 2) {
        def loc: k_fs_entry_id_t;
        def target: i32 = k_fs_readlink(argv[1], K_FS_ENTRY_TYPE_DIR, &state->fs, &loc);
        if (target != 0) {
            k_io_print("unable to find path for '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -1;
        } else {
            state->fs = loc;
            return 0;
        }
    } else {
        k_io_print("unexpected number of entries for ");
        k_io_print(argv[0]);
        k_io_print("\n");
    }
}

fn k_shell_fn_exec(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    if (argc >= 2) {
        def loc: k_fs_entry_id_t;
        if (k_fs_readlink(argv[1], K_FS_ENTRY_TYPE_FILE, &state->fs, &loc) != 0) {
            k_io_print("unable to find file for '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -1;
        }

        def dir_entry: k_fs_directory_entry_t;
        if (k_fs_get_dir_entry_by_id(loc, &dir_entry) == 0) {
            if (dir_entry.entry_type == K_FS_ENTRY_TYPE_FILE) {
                if ((dir_entry.attributes & K_FS_ATTRIBUTE_EXECUTABLE) == 0) {
                    k_io_print("file is not marked as executable\n");
                    return -3;
                }

                def exec_state: k_exec_state_t;
                exec_state.cwd = state->fs;
                exec_state.state = state;
                argv[1] = &dir_entry.name[0];

                loc.entry = dir_entry.base_block;

                return k_link_start_executable(loc, &exec_state, &argv[1], argc - 1);
            } else {
                k_io_print("entry '");
                k_io_print(argv[1]);
                k_io_print("' is not a file entry\n");
                return -2;
            }
        } else {
            k_io_print("unable to find entry with name '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -3;
        }
    } else {
        k_io_print("unexpected number of entries for ");
        k_io_print(argv[0]);
        k_io_print("\n");
        k_io_print_uint(argc);
        k_io_print("\n");
        return -1;
    }
}

fn k_shell_fn_exports(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_io_print("Export Location: ");
    k_io_print_hex(K_LINK_EXPORT_DATA);
    k_io_print(", Size: ");
    k_io_print_uint(K_LINK_EXPORT_SIZE);
    k_io_print("\n");
    return k_link_print_exports();
}

fn k_shell_fn_pwd(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_disk_fs_t = k_disk_get(state->fs.disk_index);
    if (disk == 0) {
        return -1;
    }

    if (state->fs.entry != 0) {
        def entry_stack: [100]u16;
        def entry_count: u32 = 0;

        def entry_i: k_fs_entry_id_t = state->fs;

        while (entry_i.entry != disk->vol_hdr.root_sector) {
            def entry_hdr: k_fs_entry_header_t;
            if (0 != k_fs_read_entry_header(entry_i, &entry_hdr)) {
                k_io_print("error processing folder values\n");
                entry_count = 0;
                break;
            }
            entry_stack[entry_count] = entry_i.entry;
            entry_count = entry_count + 1;
            entry_i.entry = entry_hdr.parent;
        }
        entry_stack[entry_count] = disk->vol_hdr.root_sector;

        def name_array: [K_FS_ENTRY_NAME_LEN + 1]u8;
        k_memset(&name_array, 0, K_FS_ENTRY_NAME_LEN + 1);

        k_io_print_uint(state->fs.disk_index);
        k_io_print(":");

        if (entry_count > 0) {
            while (entry_count != 0) {
                k_io_print("/");
                def parent: u16 = entry_stack[entry_count];
                entry_count = entry_count - 1;
                def current: u16 = entry_stack[entry_count];
                entry_i.entry = parent;

                def folder_entry: k_fs_directory_entry_t;
                if (k_fs_get_dir_entry_by_parent_id(entry_i, current, &folder_entry) == 0) {
                    k_memcpy(&name_array, &folder_entry.name, K_FS_ENTRY_NAME_LEN);
                    k_io_print(&name_array);
                } else {
                    k_io_print("err::");
                    k_io_print("(");
                    k_io_print_uint(current);
                    k_io_print(":");
                    k_io_print_uint(parent);
                    k_io_print(")");
                }
            }
        } else {
            k_io_print("/");
        }

        k_io_print("\n");
        return 0;
    } else {
        k_io_print("No disk mounted\n");
        return -1;
    }
}

fn k_shell_fn_reset(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_disk_fs_close_all();
    k_cpu_reset();
    return 0;
}

fn k_shell_fn_mount(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    if (state == 0) {
        k_io_print("disk open state null\n");
        return 1;
    }

    def disk_num: i32 = 0;
    def disk: *k_disk_fs_t = k_disk_get(disk_num);
    if (disk == NULL) {
        disk = k_disk_fs_open(disk_num);
        if (disk != NULL) {
            k_io_print("Mounted disk ");
            k_io_print_int(disk_num);
            k_io_print("\n");
        } else {
            k_io_print("error mounting disk\n");
            return 1;
        }
    } else {
        k_io_print("disk already mounted\n");
    }

    if (disk != NULL) {
        state->fs.entry = disk->vol_hdr.root_sector;
        state->fs.disk_index = disk_num;

        def entry: k_fs_directory_entry_t;
        if ((0 == k_disk_fs_get_dir_entry_by_name(disk, disk->vol_hdr.root_sector, "bin", &entry)) && entry.entry_type == K_FS_ENTRY_TYPE_DIR) {
            state->path[disk_num] = entry.base_block;
        } else {
            state->path[disk_num] = NULL;
        }

        return 0;
    } else {
        state->fs.entry = 0;
        state->fs.disk_index = -1;
        state->path[disk_num] = NULL;
        k_io_print("unable to mount disk\n");
        return 1;
    }
}

fn k_shell_fn_umount(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk_num: i32 = state->fs.disk_index;
    if (disk_num < 0) {
        k_io_print("unknown disk to unmount\n");
        return -1;
    }

    state->fs.entry = 0;
    state->fs.disk_index = -1;
    state->path[disk_num] = 0;
    def disk: *k_disk_fs_t = k_disk_get(disk_num);
    if (disk != 0) {
        if (k_disk_fs_close(disk_num) != 0) {
            k_io_print("Error unmounting disk\n");
            return -1;
        } else {
            k_io_print("Disk Unmounted\n");
            return 0;
        }
    } else {
        k_io_print("Disk Not Mounted\n");
        return -1;
    }
}

fn k_shell_fn_date(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def dt: k_datetime_t = k_rtc_current();
    k_print_date(&dt);
    k_io_print("\n");
    return 0;
}

fn k_shell_fn_mem(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_heap_print();
    return 0;
}

fn k_shell_fn_dbg(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_io_print_stat("DBG", argc);

    if (argc == 1) {
        k_io_print("Debug Output ");
        if (K_DBG_ENABLED) {
            k_io_print("Enabled");
        } else {
            k_io_print("Disabled");
        }
        k_io_print("\n");
    } else if (strcmp(argv[1], "on") == 0) {
        K_DBG_ENABLED = 1;
    } else if (strcmp(argv[1], "off") == 0) {
        K_DBG_ENABLED = 0;
    } else {
        k_io_print("Unknown dbg command ");
        k_io_print(argv[1]);
        k_io_print("\n");
        return 1;
    }

    return 0;
}

fn k_shell_fn_halt(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    if (argc == 1) {
        asm { "brk"; }
    } else if (strcmp(argv[1], "on") == 0) {
        state->auto_halt = 1;
    } else if (strcmp(argv[1], "off") == 0) {
        state->auto_halt = 0;
    } else {
        k_io_print("Unknown halt command ");
        k_io_print(argv[1]);
        k_io_print("\n");
        return 1;
    }

    return 0;
}

fn k_shell_split_args(input: *u8, args: **u8) i32 {
    def count: i32 = 0;
    def c: *u8 = input;

    while (*c != '\0') {
        // Skip any leading spaces
        while ((*c == ' ') || (*c == '\n')) {
            c = c + 1;
        }

        // Add the argument if it is not the end
        if (*c == '\0') {
            break;
        }

        args[count] = c;
        count = count + 1;

        while ((*c != '\0') && (*c != ' ') && (*c != '\n')) {
            c = c + 1;
        }

        if (*c != '\0') {
            *c = '\0';
            c = c + 1;
        }
    }

    return count;
}

fn k_shell_fn_exec_path(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    if (
        state &&
        (argc >= 1)) {

        def out_entry: k_fs_directory_entry_t;
        def exec_node: k_fs_entry_id_t;
        exec_node.disk_index = 0;
        while (exec_node.disk_index < K_DISK_NUM_MOUNTS) {
            exec_node.entry = state->path[exec_node.disk_index];
            if ((exec_node.entry != 0) &&
                (k_fs_get_dir_entry_by_name(exec_node, argv[0], &out_entry) == 0) &&
                (out_entry.entry_type == K_FS_ENTRY_TYPE_FILE) &&
                (out_entry.attributes & K_FS_ATTRIBUTE_EXECUTABLE)
                ) {
                // Create the executable state
                def exec_state: k_exec_state_t;
                exec_state.cwd = state->fs;
                exec_state.state = state;

                // Set the file path
                exec_node.entry = out_entry.base_block;

                // Start the executable
                return k_link_start_executable(exec_node, &exec_state, argv, argc);
            }

            exec_node.disk_index = exec_node.disk_index + 1;
        }
    }

    k_io_print("^! Unknown Command: ");
    k_io_print(argv[0]);
    k_io_print("\n");
    return -1;
}

fn k_shell_run_script(state: *k_shell_state_t, script_file: k_fs_entry_id_t, argv: **u8, argc: i32) i32 {
    def arg_buffer: [K_SHELL_DEFAULT_ARG_SPLIT_SIZE]*u8;

    def read_state: k_fs_io_state_t;
    if (k_fs_io_state_init(script_file, 0, 0, &read_state) >= 0) {
        // Add one to the data size for null character in the array
        const DATA_SIZE: u32 = 128;
        def run_data: [DATA_SIZE + 1]u8;
        def read_size: u32 = DATA_SIZE;

        while (k_fs_io_state_read_next_section_until(&read_state, &run_data, &read_size, '\n') > 0) {
            // Add the null character to the end
            run_data[read_size] = 0;
            def input_data: *u8 = run_data;

            // Only process if the line doesn't start with a #
            if (run_data[0] != '#') {
                def count: i32 = k_shell_split_args(input_data, &arg_buffer);
                if (K_DBG_ENABLED) {
                    k_io_print_stat("Arg Count", count);
                }
                k_shell_run_cmd(state, &arg_buffer, count);
            }
            read_size = DATA_SIZE;
        }
        k_io_print("\n");
    }

    return 0;
}

fn k_shell_fn_run(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_disk_fs_t = k_disk_get(state->fs.disk_index);
    if (disk == 0) {
        return -1;
    }

    if (argc >= 2) {
        def loc: k_fs_entry_id_t;
        def res: i32 = k_fs_readlink(argv[1], K_FS_ENTRY_TYPE_FILE, &state->fs, &loc);
        if (res != 0) {
            k_io_print("unable to find file for '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -1;
        }

        def read_state: k_fs_io_state_t;
        if (k_fs_io_state_init(loc, 0, sizeof(u32), &read_state) >= 0) {
            def magic_data: u32 = 0;
            def read_size: u32 = sizeof(magic_data);

            if (k_fs_io_state_read_next_section(&read_state, &magic_data, &read_size) > 0) {
                if (magic_data != K_SHELL_MAGIC_HDR) {
                    k_io_print("unknown script type - should start with '#!sh'\n");
                    return -1;
                }
            } else {
                k_io_print("unable to read magic number\n");
                return -1;
            }
        }

        return k_shell_run_script(state, loc, &argv[1], argc - 1);
    } else {
        k_io_print("unexpected number of entries for ");
        k_io_print(argv[0]);
        k_io_print("\n");
        return -1;
    }
}

fn k_shell_run_binary(state: *k_shell_state_t, exec: k_fs_entry_id_t, argv: **u8, argc: i32) i32 {
    def exec_state: k_exec_state_t;
    exec_state.cwd = state->fs;
    exec_state.state = state;
    return k_link_start_executable(exec, &exec_state, argv, argc);
}

fn k_shell_find_in_path(state: *k_shell_state_t, file: *u8) k_fs_entry_id_t {
    def out_entry: k_fs_directory_entry_t;
    def search_node: k_fs_entry_id_t;

    // First search the current directory
    if (k_fs_readlink(file, K_FS_ENTRY_TYPE_FILE, &state->fs, &search_node) == 0) {
        if ((search_node.entry != 0) &&
            (k_fs_get_dir_entry_by_id(search_node, &out_entry) == 0) &&
            (out_entry.entry_type == K_FS_ENTRY_TYPE_FILE) &&
            (out_entry.attributes & K_FS_ATTRIBUTE_EXECUTABLE)
            ) {
            // Return the resulting file
            search_node.entry = out_entry.base_block;
            return search_node;
        }
    }

    // Then search in PATH
    def i: i32 = 0;
    while (i < K_DISK_NUM_MOUNTS) {
        search_node.disk_index = i;
        search_node.entry = state->path[i];
        if ((search_node.entry != 0) &&
            (k_fs_get_dir_entry_by_name(search_node, file, &out_entry) == 0) &&
            (out_entry.entry_type == K_FS_ENTRY_TYPE_FILE) &&
            (out_entry.attributes & K_FS_ATTRIBUTE_EXECUTABLE)
            ) {
            // Return the resulting file
            search_node.entry = out_entry.base_block;
            return search_node;
        }

        i = i + 1;
    }

    search_node.entry = 0;
    search_node.disk_index = -1;
    return search_node;
}

fn k_shell_run_path(state: *k_shell_state_t, argv: **u8, argc: i32) i32 {
    if (argc == 0) {
        return -1;
    }

    // Search for file, first from local directory. If not, then look in PATH
    def file: k_fs_entry_id_t = k_shell_find_in_path(state, argv[0]);

    def read_state: k_fs_io_state_t;
    if ((file.entry != 0) && (k_fs_io_state_init(file, 0, sizeof(u32), &read_state) >= 0)) {
        def magic_data: u32 = 0;
        def read_size: u32 = sizeof(magic_data);

        if (k_fs_io_state_read_next_section(&read_state, &magic_data, &read_size) > 0) {
            if (magic_data == K_EXEC_MAGIC_HDR) {
                return k_shell_run_binary(state, file, argv, argc);
            } else if (magic_data == K_SHELL_MAGIC_HDR) {
                return k_shell_run_script(state, file, argv, argc);
            } else {
                k_io_print("unknown executable type\n");
            }
        } else {
            k_io_print("unable to read magic number\n");
            return -1;
        }
    } else {
        k_io_print("unable no valid executable found\n");
        return -1;
    }
}

fn k_shell_run_cmd(state: *k_shell_state_t, argv: **u8, argc: i32) i32 {
    if (K_DBG_ENABLED) {
        k_io_print("Arg Count: ");
        k_io_print_uint(argc);
        k_io_print("\n");

        def i: i32 = 0;
        while (i < argc) {
            k_io_print("  [");
            k_io_print_uint(i);
            k_io_print("] = ");
            k_io_print(argv[i]);
            k_io_print("\n");
            i = i + 1;
        }
    }

    if (argc > 0) {
        def cmd: *u8 = argv[0];
        if (K_DBG_ENABLED) {
            k_io_print("CMD: ");
            k_io_print(cmd);
            k_io_print("\n");
        }

        def sh_fn: fn(*k_shell_state_t,**u8,u32) i32 = 0;

        if (strcmp(cmd, "?") == 0 || strcmp(cmd, "help") == 0) {
            sh_fn = k_shell_fn_help;
        } else if (strcmp(cmd, "ls") == 0) {
            sh_fn = k_shell_fn_ls;
        } else if (strcmp(cmd, "cd") == 0) {
            sh_fn = k_shell_fn_cd;
        } else if (strcmp(cmd, "halt") == 0) {
            sh_fn = k_shell_fn_halt;
        } else if (strcmp(cmd, "pwd") == 0) {
            sh_fn = k_shell_fn_pwd;
        } else if (strcmp(cmd, "reset") == 0) {
            sh_fn = k_shell_fn_reset;
        } else if (strcmp(cmd, "date") == 0) {
            sh_fn = k_shell_fn_date;
        } else if (strcmp(cmd, "mem") == 0) {
            sh_fn = k_shell_fn_mem;
        } else if (strcmp(cmd, "mount") == 0) {
            sh_fn = k_shell_fn_mount;
        } else if (strcmp(cmd, "umount") == 0) {
            sh_fn = k_shell_fn_umount;
        } else if (strcmp(cmd, "dbg") == 0) {
            sh_fn = k_shell_fn_dbg;
        } else if (strcmp(cmd, "run") == 0) {
            sh_fn = k_shell_fn_run;
        } else if (strcmp(cmd, "exports") == 0) {
            sh_fn = k_shell_fn_exports;
        }

        if (sh_fn != 0) {
            def res: i32 = sh_fn(state, argv, argc);
            if (res != 0) {
                k_io_print("^! Error running ");
                k_io_print(cmd);
                k_io_print("\n   Return Code: ");
                k_io_print_int(res);
                k_io_print("\n");
            }
            return res;
        }

        return k_shell_run_path(state, argv, argc);
    }
}

#endif // K_SHELL
