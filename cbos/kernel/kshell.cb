#ifndef K_SHELL
#define K_SHELL

#include kdbg.cb
#include kfs.cb
#include klink.cb
#include kmalloc.cb
#include kmalloc_dbg.cb
#include kserialio.cb

const K_SHELL_DEFAULT_INPUT_BUFFER_SIZE: u32 = 128;
const K_SHELL_DEFAULT_ARG_SPLIT_SIZE: u32 = 8;
const K_SHELL_NUM_MOUNTABLE_DISKS: u32 = 4;

struct k_shell_state_global_t {
    disks: [K_SHELL_NUM_MOUNTABLE_DISKS]*k_fs_disk_t; // Current mounted disk
}

struct k_shell_state_t {
    global_state: *k_shell_state_global_t; // Global State
    cwd: u16; // Current Directory
    path_fd: u16; // Current PATH directory
    disk_index: i32; // Current disk identifier
    auto_halt: u8;
}

fn _k_shell_get_disk(state: *k_shell_state_t) *k_fs_disk_t {
    if ((state == 0) || (state->global_state == 0)) {
        return 0;
    } else {
        return state->global_state->disks[state->disk_index];
    }
}

fn k_shell_print_date(dt: *k_datetime_t) void {
    k_io_print_uint_width(dt->year, 4);
    k_io_print("-");
    k_io_print_uint_width(dt->month, 2);
    k_io_print("-");
    k_io_print_uint_width(dt->day + 1, 2);
    k_io_print(" ");
    k_io_print_uint_width(dt->hour, 2);
    k_io_print(":");
    k_io_print_uint_width(dt->minute, 2);
    k_io_print(":");
    k_io_print_uint_width(dt->second, 2);
}

fn k_shell_run_cmd(state: *k_shell_state_t, argv: **u8, argc: i32) i32;

fn k_shell_disk_open(state: *k_shell_state_global_t, disk_num: i32) i32 {
    if (state == 0) {
        k_io_print("disk open state nullptr\n");
        return 1;
    }

    def disk: *k_fs_disk_t = state->disks[disk_num];
    if (disk == 0) {
        disk = k_fs_disk_open(disk_num);
        state->disks[disk_num] = disk;
        if (disk != 0) {
            k_io_print("Mounted disk ");
            k_io_print_int(disk_num);
            k_io_print("\n");
            return 0;
        } else {
            k_io_print("Error mounting disk\n");
            return 1;
        }
    } else {
        k_io_print("Disk already mounted\n");
        return 1;
    }
}

fn k_shell_disk_close(state: *k_shell_state_global_t, disk_num: i32) i32 {
    if (state == 0) {
        return 1;
    }

    def disk: *k_fs_disk_t = state->disks[disk_num];
    if (disk != 0) {
        k_fs_disk_close(disk);
        state->disks[disk_num] = 0;
    }
    return 0;
}

fn k_shell_fn_help(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_io_print("CB/OS v");
    k_io_print(K_OS_VERSION);
    k_io_print("\n");
    k_io_print("Supported Commands:\n");
    k_io_print("  ? / help      -> shows this help command\n");
    k_io_print("  date          -> shows the current date/time\n");
    k_io_print("  dbg           -> prints current debug output status\n");
    k_io_print("  dbg [on/off]  -> enables/disables debug output\n");
    k_io_print("  mem           -> shows the current heap allocations\n");
    k_io_print("  mount         -> mounts the current disk\n");
    k_io_print("  umount        -> umounts the current disk\n");
    k_io_print("  reset         -> resets the processor\n");
    k_io_print("  pwd           -> prints the current directory\n");
    k_io_print("  ls            -> lists entries in the current directory\n");
    k_io_print("  stat [file]   -> lists statistics for the file entry\n");
    k_io_print("  cat [file]    -> pipes the contents of the file into serial output\n");
    k_io_print("  exec [file]   -> executes the application binary provided by the compiled file,\n");
    k_io_print("                   compiled as an position-independent application file\n");
    k_io_print("  exports       -> lists symbols exported from the current OS\n");
    k_io_print("  ldd [file]    -> lists symbols imported from the current file image\n");
    k_io_print("  run [file]    -> executes the script text file provided by the given argument,\n");
    k_io_print("                   running each line of the provided file as if it were\n");
    k_io_print("                   typed into the console as a script\n");
    k_io_print("  cd [file]     -> changes directory to the provided folder\n");
    k_io_print("                   or parent directory if '..' provided\n");
    k_io_print("  reset         -> resets the processor\n");
    k_io_print("  halt          -> halts the CPU\n");
    k_io_print("  halt [on/off] -> turns on/off auto-halt\n");
    return 0;
}

fn k_shell_readlink(state: *k_shell_state_t, pathname: *u8, pathtype: u8) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if ((disk == NULL) || (pathname == NULL)) {
        return -1;
    }

    def current: *u8 = pathname;

    def start_loc: u16;
    if (*current == '/') {
        current = current + 1;
        start_loc = disk->vol_hdr.root_sector;
    } else {
        start_loc = state->cwd;
    }

    def pathtmp: [64]u8;

    while (*current != '\0') {
        def next: *u8 = current + 1;
        while ((*next != '/') && (*next != '\0')) {
            next = next + 1;
        }

        k_memset(pathtmp, 0, sizeof(pathtmp));
        k_memcpy(pathtmp, current, next - current);

        if (strcmp(pathtmp, "..") == 0) {
            def out_entry: k_fs_entry_header_t;
            if (start_loc == disk->vol_hdr.root_sector) {
                k_io_print("unable to traverse above the root node\n");
                return -1;
            } else if (0 == k_fs_read_entry_header(disk, start_loc, &out_entry)) {
                start_loc = out_entry.parent;
            } else {
                k_io_print("unable to find parent node\n");
                return -1;
            }
        } else if (strcmp(pathtmp, ".") == 0) {
            // Do Nothing
        } else {
            def out_entry: k_fs_directory_entry_t;
            if (k_fs_get_dir_entry_by_name(disk, start_loc, pathtmp, &out_entry) == 0) {
                if ((*next == NULL) || (out_entry.entry_type == K_FS_ENTRY_TYPE_DIR)) {
                    start_loc = out_entry.base_block;
                } else {
                    k_io_print("entry '");
                    k_io_print(pathname);
                    k_io_print("' is not a directory entry\n");
                    return -1;
                }
            } else {
                k_io_print("unable to find entry with name '");
                k_io_print(pathname);
                k_io_print("'\n");
                return -1;
            }
        }

        if (*next == NULL) {
            break;
        } else {
            current = next + 1;
        }
    }

    if (pathtype != 0) {
        def out_entry: k_fs_entry_header_t;
        if ((0 == k_fs_read_entry_header(disk, start_loc, &out_entry)) && (out_entry.entry_type == pathtype)) {
            return start_loc;
        } else {
            k_io_print("'");
            k_io_print(pathname);
            k_io_print("' is not a ");
            if (pathtype == 1) {
                k_io_print("directory");
            } else if (pathtype == 2) {
                k_io_print("file");
            } else {
                k_io_print("??");
            }
            k_io_print("\n");
            return -1;
        }
    } else {
        return start_loc;
    }
}

fn k_shell_fn_ls(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if (disk != 0) {
        def target_dir: u16;

        if (argc < 2) {
            target_dir = state->cwd;
        } else if (argc == 2) {
            def target: i32 = k_shell_readlink(state, argv[1], K_FS_ENTRY_TYPE_DIR);
            if (target <= 0) {
                k_io_print("unable to find path for '");
                k_io_print(argv[1]);
                k_io_print("'\n");
                return -1;
            } else {
                target_dir = target : u16;
            }
        } else {
            k_io_print("unexpected number of arguments provided for ls\n");
            return -1;
        }

        const ENTRY_SIZE_LIM: u32 = 10;
        def test_entries: [ENTRY_SIZE_LIM]k_fs_directory_entry_t;
        def test_entry_size: u32 = ENTRY_SIZE_LIM;
        def res: i32 = k_fs_read_directory_entries(disk, target_dir, &test_entries, &test_entry_size, 0);
        if (res == 0) {
            def ii: u32 = 0;
            def name_tmp: [K_FS_ENTRY_NAME_LEN+1]u8;
            k_memset(&name_tmp, 0, K_FS_ENTRY_NAME_LEN + 1);
            while (ii < test_entry_size) {
                def ent: *k_fs_directory_entry_t = &test_entries[ii];
                k_memcpy(&name_tmp, &(ent->name), K_FS_ENTRY_NAME_LEN);
                if (ent->entry_type == K_FS_ENTRY_TYPE_FILE) {
                    if (ent->attributes & K_FS_ATTRIBUTE_EXECUTABLE) {
                        k_io_print("f:* ");
                    } else {
                        k_io_print("f:  ");
                    }
                    k_io_print(name_tmp);
                    k_io_print("\n");
                } else if (ent->entry_type == K_FS_ENTRY_TYPE_DIR) {
                    k_io_print("d:  ");
                    k_io_print(name_tmp);
                    k_io_print("/\n");
                } else {
                    k_io_print("?:  ");
                    k_io_print(name_tmp);
                    k_io_print("\n");
                }
                ii = ii + 1;
            }
            return 0;
        } else {
            k_io_print("Error getting entries\n  ");
            k_io_print_int(res);
            k_io_print("\n");
            return -1;
        }
    } else {
        k_io_print("No disk mounted\n");
        return -1;
    }
}

fn k_shell_fn_cd(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if (disk == 0) {
        k_io_print("no valid disk mounted for ");
        k_io_print(argv[0]);
        k_io_print("\n");
        return -1;
    }

    if (argc < 2) {
        state->cwd = disk->vol_hdr.root_sector;
        return 0;
    } else if (argc == 2) {
        def target: i32 = k_shell_readlink(state, argv[1], K_FS_ENTRY_TYPE_DIR);
        if (target <= 0) {
            k_io_print("unable to find path for '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -1;
        } else {
            state->cwd = target : u16;
            return 0;
        }
    } else {
        k_io_print("unexpected number of entries for ");
        k_io_print(argv[0]);
        k_io_print("\n");
    }
}

fn k_shell_fn_stat(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if (disk == 0) {
        return -1;
    }

    if (argc == 2) {
        def filename: *u8 = argv[1];

        def target: i32 = k_shell_readlink(state, argv[1], 0);
        if (target <= 0) {
            k_io_print("unable to find path for '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -1;
        }

        def out_header: k_fs_entry_header_t;
        if (k_fs_read_entry_header(disk, target : u16, &out_header) == 0) {
            if (out_header.entry_type == K_FS_ENTRY_TYPE_FILE) {
                def out_entry: k_fs_directory_entry_t;
                if (k_fs_get_dir_entry_by_id(disk, out_header.parent, target : u16, &out_entry) != 0) {
                    k_io_print("unable to get directory entry\n");
                    return -1;
                }

                k_io_print("  file:        ");
                k_io_print(filename);
                k_io_print("\n");
                k_io_print("  size:        ");
                k_io_print_uint(out_header.payload_size);
                k_io_print(" / ");
                k_io_print_uint(out_header.payload_size / 1024);
                k_io_print("k\n");
                k_io_print("  executable:  ");
                if (out_entry.attributes & K_FS_ATTRIBUTE_EXECUTABLE) {
                    k_io_print("y");
                } else {
                    k_io_print("n");
                }
                k_io_print("\n");
            } else if (out_header.entry_type == K_FS_ENTRY_TYPE_DIR) {
                k_io_print("  directory:   ");
                k_io_print(filename);
                k_io_print("\n");
                k_io_print("  entry count: ");
                k_io_print_uint(out_header.payload_size / sizeof(k_fs_directory_entry_t));
                k_io_print("\n");
            } else {
                k_io_print("unknown entry type\n");
                return -2;
            }

            k_io_print("  node:        ");
            k_io_print_uint(target : u16);
            k_io_print("\n");

            k_io_print("  date:        ");
            k_shell_print_date(&out_header.modification_time);
            k_io_print("\n");

            return 0;
        } else {
            k_io_print("unable to find entry with name '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -3;
        }
    } else {
        k_io_print("unexpected number of entries for ");
        k_io_print(argv[0]);
        k_io_print("\n");
        k_io_print_uint(argc);
        k_io_print("\n");
        return -1;
    }
}

fn k_shell_fn_cat(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if (disk == 0) {
        return -1;
    }

    if (argc == 2) {
        def target: i32 = k_shell_readlink(state, argv[1], K_FS_ENTRY_TYPE_FILE);
        if (target <= 0) {
            k_io_print("unable to find file for '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -1;
        }

        def read_state: k_fs_io_state_t;
        if (k_fs_io_state_init(disk, target : u16, 0, 0, &read_state) >= 0) {
            // Add one to the data size for null character in the array
            const DATA_SIZE: u32 = 128;
            def run_data: [DATA_SIZE + 1]u8;
            def read_size: u32 = DATA_SIZE;

            while (k_fs_io_state_read_next_section(&read_state, &run_data, &read_size) > 0) {
                // Add the null character to the end
                run_data[read_size] = 0;

                // Ensure that there is enough space in the output buffer before printing
                while (SERIAL_DEV->output_size + read_size > 65535) {}
                k_io_print(&run_data);

                read_size = DATA_SIZE;
            }
            k_io_print("\n");
        }

        return 0;
    } else {
        k_io_print("unexpected number of entries for ");
        k_io_print(argv[0]);
        k_io_print("\n");
        k_io_print_uint(argc);
        k_io_print("\n");
        return -1;
    }
}

fn k_shell_fn_exec(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if (disk == 0) {
        return -1;
    }

    if (argc >= 2) {
        def target: i32 = k_shell_readlink(state, argv[1], K_FS_ENTRY_TYPE_FILE);
        if (target <= 0) {
            k_io_print("unable to find file for '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -1;
        }

        def out_entry: k_fs_directory_entry_t;
        if (k_fs_get_dir_entry_by_id_only(disk, target : u16, &out_entry) == 0) {
            if (out_entry.entry_type == K_FS_ENTRY_TYPE_FILE) {
                if ((out_entry.attributes & K_FS_ATTRIBUTE_EXECUTABLE) == 0) {
                    k_io_print("file is not marked as executable\n");
                    return -3;
                }

                return k_link_start_executable(disk, out_entry.base_block, &argv[1], argc - 1);
            } else {
                k_io_print("entry '");
                k_io_print(argv[1]);
                k_io_print("' is not a file entry\n");
                return -2;
            }
        } else {
            k_io_print("unable to find entry with name '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -3;
        }
    } else {
        k_io_print("unexpected number of entries for ");
        k_io_print(argv[0]);
        k_io_print("\n");
        k_io_print_uint(argc);
        k_io_print("\n");
        return -1;
    }
}

fn k_shell_fn_exec_path(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    def out_entry: k_fs_directory_entry_t;
    if (
        (disk != 0) &&
        (state : u32 != 0) &&
        (state->path_fd != 0) &&
        (argc >= 1) &&
        (k_fs_get_dir_entry_by_name(disk, state->path_fd, argv[0], &out_entry) == 0) &&
        (out_entry.entry_type == K_FS_ENTRY_TYPE_FILE) &&
        (out_entry.attributes & K_FS_ATTRIBUTE_EXECUTABLE)
        ) {
        return k_link_start_executable(disk, out_entry.base_block, argv, argc);
    } else {
        k_io_print("^! Unknown Command: ");
        k_io_print(argv[0]);
        k_io_print("\n");
        return -1;
    }
}

fn k_shell_fn_exports(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_io_print("Export Location: ");
    k_io_print_hex(K_LINK_EXPORT_DATA);
    k_io_print(", Size: ");
    k_io_print_uint(K_LINK_EXPORT_SIZE);
    k_io_print("\n");
    return k_link_print_exports();
}

fn k_shell_fn_ldd(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    def entry: k_fs_directory_entry_t;
    if ((disk == NULL) || ((state : u32) == NULL)) {
        k_io_print("unopened disk\n");
        return -1;
    } else if (argc != 2) {
        k_io_print("Found ");
        k_io_print_uint(argc);
        k_io_print(" arguments, expected 2\n");
        return -1;
    }

    def target: i32 = k_shell_readlink(state, argv[1], K_FS_ENTRY_TYPE_FILE);
    if (target <= 0) {
        k_io_print("unable to find file for '");
        k_io_print(argv[1]);
        k_io_print("'\n");
        return -1;
    } else if ((k_fs_get_dir_entry_by_id_only(disk, target : u16, &entry) != 0)) {
        k_io_print("unable to get file entry for ");
        k_io_print(argv[1]);
        k_io_print("\n");
        return -1;
    } else if ((entry.attributes & K_FS_ATTRIBUTE_EXECUTABLE) == 0) {
        k_io_print("entry does not have executable flag set\n");
        return -1;
    }

    def read_state: k_fs_io_state_t;
    def exec_hdr: k_exec_hdr_t;

    if (k_fs_io_state_init(disk, entry.base_block, 0, sizeof(exec_hdr), &read_state) >= 0) {
        def read_size: u32 = sizeof(exec_hdr);
        def read_remaining: u32 = sizeof(exec_hdr);
        def copy_loc: *u8 = &exec_hdr;
        while (k_fs_io_state_read_next_section(&read_state, copy_loc, &read_size) > 0) {
            copy_loc = copy_loc + read_size;
            read_remaining = read_remaining - read_size;
            read_size = read_remaining;
        }
    } else {
        k_io_print("unable to find application header\n");
        return -1;
    }

    if (exec_hdr.magic_num != K_EXEC_MAGIC_HDR) {
        k_io_print("unknown executable format found\n");
        return -1;
    }

    k_io_print("Imports\n");
    if (exec_hdr.import_size > 0) {
        def link_data: *u8 = k_malloc(exec_hdr.import_size);
        if (link_data == NULL) {
            k_io_print("unable to allocate link memory\n");
            return -1;
        }

        if (k_fs_io_state_init(disk, entry.base_block, exec_hdr.import_offset, exec_hdr.import_size, &read_state) >= 0) {
            const DATA_SIZE: u32 = 128;
            def read_size: u32 = DATA_SIZE;

            // Ensure that the location is aligned
            def copy_loc: *u8 = link_data;

            // Read link data into buffer
            while (k_fs_io_state_read_next_section(&read_state, copy_loc, &read_size) > 0) {
                copy_loc = copy_loc + read_size;
                read_size = DATA_SIZE;
            }
        } else {
            k_io_print("unable to load link region into memory\n");
            k_free(link_data);
            return -1;
        }

        // Read the link data and apply
        def current_loc: *u8 = link_data;
        def end_loc: *u8 = link_data + exec_hdr.import_size;

        while (current_loc < end_loc) {
            def rgn: *k_link_rgn_t = current_loc;
            current_loc = current_loc + sizeof(k_link_rgn_t);

            def name: *u8 = current_loc;
            current_loc = current_loc + rgn->name_size;

            k_io_print("  ");
            k_io_print(name);
            k_io_print(": ");
            k_io_print_hex(rgn->offset);
            k_io_print("\n");
        }

        k_free(link_data);
    }

    k_io_print("Exports\n");
    if (exec_hdr.export_size > 0) {
        def export_data: *u8 = k_malloc(exec_hdr.export_size);
        if (export_data == NULL) {
            k_io_print("unable to allocate export memory\n");
            return -1;
        }

        if (k_fs_io_state_init(disk, entry.base_block, exec_hdr.export_offset, exec_hdr.export_size, &read_state) >= 0) {
            const DATA_SIZE: u32 = 128;
            //def run_data: [DATA_SIZE]u8;
            def read_size: u32 = DATA_SIZE;

            // Ensure that the location is aligned
            def copy_loc: *u8 = export_data;

            // Read link data into buffer
            while (k_fs_io_state_read_next_section(&read_state, copy_loc, &read_size) > 0) {
                copy_loc = copy_loc + read_size;
                read_size = DATA_SIZE;
            }
        } else {
            k_io_print("unable to load export region into memory\n");
            k_free(export_data);
            return -1;
        }

        // Read the link data and apply
        def current_loc: *u8 = export_data;
        def end_loc: *u8 = export_data + exec_hdr.export_size;

        while (current_loc < end_loc) {
            def rgn: *k_link_rgn_t = current_loc;
            current_loc = current_loc + sizeof(k_link_rgn_t);

            def name: *u8 = current_loc;
            current_loc = current_loc + rgn->name_size;

            k_io_print("  ");
            k_io_print(name);
            k_io_print(": ");
            k_io_print_hex(rgn->offset);
            k_io_print("\n");
        }

        k_free(export_data);
    }

    return 0;
}

fn k_shell_fn_pwd(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if (disk == 0) {
        return -1;
    }

    if (state->cwd != 0) {
        def entry_stack: [100]u16;
        def entry_count: u32 = 0;

        def entry_i: u16 = state->cwd;

        while (entry_i != disk->vol_hdr.root_sector) {
            def entry_hdr: k_fs_entry_header_t;
            if (0 != k_fs_read_entry_header(disk, entry_i, &entry_hdr)) {
                k_io_print("error processing folder values\n");
                entry_count = 0;
                break;
            }
            entry_stack[entry_count] = entry_i;
            entry_count = entry_count + 1;
            entry_i = entry_hdr.parent;
        }
        entry_stack[entry_count] = disk->vol_hdr.root_sector;

        def name_array: [K_FS_ENTRY_NAME_LEN + 1]u8;
        k_memset(&name_array, 0, K_FS_ENTRY_NAME_LEN + 1);

        if (entry_count > 0) {
            while (entry_count != 0) {
                k_io_print("/");
                def parent: u16 = entry_stack[entry_count];
                entry_count = entry_count - 1;
                def current: u16 = entry_stack[entry_count];

                def folder_entry: k_fs_directory_entry_t;
                if (k_fs_get_dir_entry_by_id(disk, parent, current, &folder_entry) == 0) {
                    k_memcpy(&name_array, &folder_entry.name, K_FS_ENTRY_NAME_LEN);
                    k_io_print(&name_array);
                } else {
                    k_io_print("err::");
                    k_io_print("(");
                    k_io_print_uint(current);
                    k_io_print(":");
                    k_io_print_uint(parent);
                    k_io_print(")");
                }
            }
        } else {
            k_io_print("/");
        }

        k_io_print("\n");
        return 0;
    } else {
        k_io_print("No disk mounted\n");
        return -1;
    }
}

fn k_shell_fn_reset(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_shell_disk_close(state->global_state, state->disk_index);
    k_cpu_reset();
    return 0;
}

fn k_shell_fn_mount(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    state->disk_index = 0;
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if ((disk == 0)) {
        if ((k_shell_disk_open(state->global_state, state->disk_index) != 0)) {
            k_io_print("unable to open disk\n");
            return 1;
        } else {
            disk = _k_shell_get_disk(state);
        }
    }

    if (disk != 0) {
        state->cwd = disk->vol_hdr.root_sector;
        def entry: k_fs_directory_entry_t;
        if ((0 == k_fs_get_dir_entry_by_name(disk, disk->vol_hdr.root_sector, "bin", &entry)) && entry.entry_type == K_FS_ENTRY_TYPE_DIR) {
            state->path_fd = entry.base_block;
        } else {
            state->path_fd = 0;
        }

        return 0;
    } else {
        state->cwd = 0;
        state->path_fd = 0;
        k_io_print("unable to mount disk\n");
        return 1;
    }
}

fn k_shell_fn_umount(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    state->cwd = 0;
    state->path_fd = 0;
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if (disk != 0) {
        def res: i32 = k_shell_disk_close(state->global_state, state->disk_index);
        k_io_print("Disk Unmounted\n");
        return res;
    } else {
        k_io_print("Disk Not Mounted\n");
        return -1;
    }
}

fn k_shell_fn_date(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def dt: k_datetime_t = k_rtc_current();
    k_shell_print_date(&dt);
    k_io_print("\n");
    return 0;
}

fn k_shell_fn_mem(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_heap_print();
    return 0;
}

fn k_shell_fn_dbg(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    k_io_print_stat("DBG", argc);

    if (argc == 1) {
        k_io_print("Debug Output ");
        if (K_DBG_ENABLED) {
            k_io_print("Enabled");
        } else {
            k_io_print("Disabled");
        }
        k_io_print("\n");
    } else if (strcmp(argv[1], "on") == 0) {
        K_DBG_ENABLED = 1;
    } else if (strcmp(argv[1], "off") == 0) {
        K_DBG_ENABLED = 0;
    } else {
        k_io_print("Unknown dbg command ");
        k_io_print(argv[1]);
        k_io_print("\n");
        return 1;
    }

    return 0;
}

fn k_shell_fn_halt(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    if (argc == 1) {
        asm { "brk"; }
    } else if (strcmp(argv[1], "on") == 0) {
        state->auto_halt = 1;
    } else if (strcmp(argv[1], "off") == 0) {
        state->auto_halt = 0;
    } else {
        k_io_print("Unknown halt command ");
        k_io_print(argv[1]);
        k_io_print("\n");
        return 1;
    }

    return 0;
}

fn k_shell_split_args(input: *u8, args: **u8) i32 {
    def count: i32 = 0;
    def c: *u8 = input;

    while (*c != '\0') {
        // Skip any leading spaces
        while ((*c == ' ') || (*c == '\n')) {
            c = c + 1;
        }

        // Add the argument if it is not the end
        if (*c == '\0') {
            break;
        }

        args[count] = c;
        count = count + 1;

        while ((*c != '\0') && (*c != ' ') && (*c != '\n')) {
            c = c + 1;
        }

        if (*c != '\0') {
            *c = '\0';
            c = c + 1;
        }
    }

    return count;
}

fn k_shell_fn_run(state: *k_shell_state_t, argv: **u8, argc: u32) i32 {
    def disk: *k_fs_disk_t = _k_shell_get_disk(state);
    if (disk == 0) {
        return -1;
    }

    def arg_buffer: [K_SHELL_DEFAULT_ARG_SPLIT_SIZE]*u8;

    if (argc == 2) {
        def target: i32 = k_shell_readlink(state, argv[1], K_FS_ENTRY_TYPE_FILE);
        if (target <= 0) {
            k_io_print("unable to find file for '");
            k_io_print(argv[1]);
            k_io_print("'\n");
            return -1;
        }

        def read_state: k_fs_io_state_t;
        if (k_fs_io_state_init(disk, target : u16, 0, 0, &read_state) >= 0) {
            // Add one to the data size for null character in the array
            const DATA_SIZE: u32 = 128;
            def run_data: [DATA_SIZE + 1]u8;
            def read_size: u32 = DATA_SIZE;

            while (k_fs_io_state_read_next_section_until(&read_state, &run_data, &read_size, '\n') > 0) {
                // Add the null character to the end
                run_data[read_size] = 0;
                def input_data: *u8 = run_data;

                def count: i32 = k_shell_split_args(input_data, &arg_buffer);
                if (K_DBG_ENABLED) {
                    k_io_print_stat("Arg Count", count);
                }
                k_shell_run_cmd(state, &arg_buffer, count);
                read_size = DATA_SIZE;
            }
            k_io_print("\n");
        }

        return 0;
    } else {
        k_io_print("unexpected number of entries for ");
        k_io_print(argv[0]);
        k_io_print("\n");
        return -1;
    }
}

fn k_shell_run_cmd(state: *k_shell_state_t, argv: **u8, argc: i32) i32 {
    if (K_DBG_ENABLED) {
        k_io_print("Arg Count: ");
        k_io_print_uint(argc);
        k_io_print("\n");

        def i: i32 = 0;
        while (i < argc) {
            k_io_print("  [");
            k_io_print_uint(i);
            k_io_print("] = ");
            k_io_print(argv[i]);
            k_io_print("\n");
            i = i + 1;
        }
    }

    if (argc > 0) {
        def cmd: *u8 = argv[0];
        if (K_DBG_ENABLED) {
            k_io_print("CMD: ");
            k_io_print(cmd);
            k_io_print("\n");
        }

        def sh_fn: fn(*k_shell_state_t,**u8,u32) i32 = 0;

        if (strcmp(cmd, "?") == 0 || strcmp(cmd, "help") == 0) {
            sh_fn = k_shell_fn_help;
        } else if (strcmp(cmd, "ls") == 0) {
            sh_fn = k_shell_fn_ls;
        } else if (strcmp(cmd, "stat") == 0) {
            sh_fn = k_shell_fn_stat;
        } else if (strcmp(cmd, "cd") == 0) {
            sh_fn = k_shell_fn_cd;
        } else if (strcmp(cmd, "cat") == 0) {
            sh_fn = k_shell_fn_cat;
        } else if (strcmp(cmd, "halt") == 0) {
            sh_fn = k_shell_fn_halt;
        } else if (strcmp(cmd, "pwd") == 0) {
            sh_fn = k_shell_fn_pwd;
        } else if (strcmp(cmd, "reset") == 0) {
            sh_fn = k_shell_fn_reset;
        } else if (strcmp(cmd, "date") == 0) {
            sh_fn = k_shell_fn_date;
        } else if (strcmp(cmd, "mem") == 0) {
            sh_fn = k_shell_fn_mem;
        } else if (strcmp(cmd, "mount") == 0) {
            sh_fn = k_shell_fn_mount;
        } else if (strcmp(cmd, "umount") == 0) {
            sh_fn = k_shell_fn_umount;
        } else if (strcmp(cmd, "dbg") == 0) {
            sh_fn = k_shell_fn_dbg;
        } else if (strcmp(cmd, "run") == 0) {
            sh_fn = k_shell_fn_run;
        } else if (strcmp(cmd, "exec") == 0) {
            sh_fn = k_shell_fn_exec;
        } else if (strcmp(cmd, "exports") == 0) {
            sh_fn = k_shell_fn_exports;
        } else if (strcmp(cmd, "ldd") == 0) {
            sh_fn = k_shell_fn_ldd;
        }

        if (sh_fn != 0) {
            def res: i32 = sh_fn(state, argv, argc);
            if (res != 0) {
                k_io_print("^! Error running ");
                k_io_print(cmd);
                k_io_print("\n   Return Code: ");
                k_io_print_int(res);
                k_io_print("\n");
            }
            return res;
        }

        return k_shell_fn_exec_path(state, argv, argc);
    }
}

#endif // K_SHELL
