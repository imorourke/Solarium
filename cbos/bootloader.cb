#include <kernel/kcpu.cb>
#include <kernel/kdisk.cb>
#include <kernel/kdevice.cb>
#include <kernel/kfs.cb>
#include <kernel/kserialio.cb>
#include <kernel/klink.cb>

global BOOT_KERNEL_NAME: *u8 = "boot.bin";
const LOAD_LOC: u32 = 0x2000u32;

fn k_link_start_kernel(disk: *k_disk_fs_t, entry: u16) i32 {
    def read_state: k_fs_io_state_t;
    def exec_hdr: k_exec_hdr_t;
    def copy_loc: *u8;

    if (k_disk_fs_io_state_init(disk, entry, 0, sizeof(exec_hdr), &read_state) >= 0) {
        def read_size: u32 = sizeof(exec_hdr);
        def read_remaining: u32 = sizeof(exec_hdr);
        copy_loc = &exec_hdr;
        while (k_fs_io_state_read_next_section(&read_state, copy_loc, &read_size) > 0) {
            copy_loc = copy_loc + read_size;
            read_remaining = read_remaining - read_size;
            read_size = read_remaining;
        }
    } else {
        k_io_print("unable to find application header\n");
        return -1;
    }

    if (exec_hdr.magic_num != K_EXEC_MAGIC_HDR) {
        k_io_print("unknown executable format found\n");
        return -1;
    }

    if (exec_hdr.attribute != LOAD_LOC) {
        k_io_print("unsupported load location\n");
        return -1;
    }

    def app_data: *u8 = LOAD_LOC;
    copy_loc = app_data;

    if (k_disk_fs_io_state_init(disk, entry, exec_hdr.prog_offset, exec_hdr.prog_size, &read_state) >= 0) {
        const DATA_SIZE: u32 = 128;
        def read_size: u32 = DATA_SIZE;

        // Copy code into location
        def print_i: u32 = 0;
        while (k_fs_io_state_read_next_section(&read_state, copy_loc, &read_size) > 0) {
            copy_loc = copy_loc + read_size;
            read_size = DATA_SIZE;

            print_i = (print_i + 1) % 24;
            if (print_i == 0) {
                k_io_print_uint(read_state.bytes_read);
                k_io_print(" / ");
                k_io_print_int(read_state.span_size);
                k_io_print("\n");
            }
        }
    } else {
        k_io_print("unable to load binary into memory\n");
        return -1;
    }

    def export_loc: *u8 = copy_loc;

    if (exec_hdr.export_size > 0) {
        k_io_print("Loading export table\n");
        if (k_disk_fs_io_state_init(disk, entry, exec_hdr.export_offset, exec_hdr.export_size, &read_state) >= 0) {
            const DATA_SIZE: u32 = 128;
            def read_size: u32 = DATA_SIZE;

            // Read link data into buffer
            while (k_fs_io_state_read_next_section(&read_state, copy_loc, &read_size) > 0) {
                copy_loc = copy_loc + read_size;
                read_size = DATA_SIZE;
            }
        } else {
            k_io_print("unable to load export region into memory\n");
        }
    }

    def link_success: u8 = 1;

    if (exec_hdr.import_size > 0) {
        k_io_print("Loading import table\n");
        def link_data: *u8 = k_malloc(exec_hdr.import_size);

        if ((link_data != NULL) && (k_disk_fs_io_state_init(disk, entry, exec_hdr.import_offset, exec_hdr.import_size, &read_state) >= 0)) {
            const DATA_SIZE: u32 = 128;
            def read_size: u32 = DATA_SIZE;

            // Ensure that the location is aligned
            copy_loc = link_data;

            // Read link data into buffer
            while (k_fs_io_state_read_next_section(&read_state, copy_loc, &read_size) > 0) {
                //k_memcpy(copy_loc, &run_data[0], read_size);
                copy_loc = copy_loc + read_size;
                read_size = DATA_SIZE;
            }
        } else {
            k_io_print("unable to load link region into memory\n");
        }

        if (link_success) {
            // Read the link data and apply
            def current_loc: *u8 = link_data;
            def end_loc: *u8 = link_data + exec_hdr.import_size;

            while (current_loc < end_loc) {
                def rgn: *k_link_rgn_t = current_loc;
                current_loc = current_loc + sizeof(k_link_rgn_t);

                def name: *u8 = current_loc;
                current_loc = current_loc + rgn->name_size;

                def addr: u32;
                def valid: u8 = 0;
                if (strcmp(name, "K_LINK_EXPORT_DATA") == 0) {
                    addr = export_loc;
                    valid = 1;
                } else if (strcmp(name, "K_LINK_EXPORT_SIZE") == 0) {
                    addr = exec_hdr.export_size;
                    valid = 1;
                }

                if (valid) {
                    *(rgn->offset : *u32) = addr;
                } else {
                    k_io_print("unable to find location for symbol '");
                    k_io_print(name);
                    k_io_print("'\n");
                    link_success = 0;
                }
            }
        }

        if (link_data != NULL) {
            k_free(link_data);
        }
    }

    if (!link_success) {
        return -1;
    } else {
        return 0;
    }
}

fn main() void {
    k_device_init(0);
    k_io_init();
    k_disk_init();

    def cwd: u16; // Current Directory

    k_io_print("Opening disk...\n");
    def disk: *k_disk_fs_t = k_disk_fs_open(0);
    if (disk != 0) {
        cwd = disk->vol_hdr.root_sector;
    }

    k_io_print("Looking for '");
    k_io_print(BOOT_KERNEL_NAME);
    k_io_print("'...\n");

    def out_entry: k_fs_directory_entry_t;
    if (k_disk_fs_get_dir_entry_by_name(disk, cwd, BOOT_KERNEL_NAME, &out_entry) == 0) {
        k_io_print("Found boot entry\n");
        if (out_entry.entry_type == K_FS_ENTRY_TYPE_FILE) {
            if (k_link_start_kernel(disk, out_entry.base_block) == 0) {
                asm {
                    "ldi 8:u16 0x2000";
                    "jmp 8";
                }
            } else {
                k_io_print("unable to initialize kernel\n");
            }
        } else {
            k_io_print("no boot file found - directory found instead\n");
        }
    } else {
        k_io_print("no boot file found\n");
    }

    asm { "halt"; }
}
