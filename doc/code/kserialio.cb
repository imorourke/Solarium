struct k_serial_control_t {
    device_id: u16;
    input_size: u16;
    output_size: u16;
    input_data: u8;
    output_data: u8;
    reset_input: u8;
    reset_output: u8;
    interrupt_num: u8;
    interrupt_char: u8;
}

#ifdef K_SERIAL_IO_CBUOY_PRINT
fn k_io_print_intf(out_dev: *u8, c: *u8) void {
    while (*c != 0) {
        *out_dev = *c;
        c = c + 1;
    }
}
#else
asmfn k_io_print_intf(out_dev: *u8, c: *u8) void {
    "push $stat";
    "intoff";
    "ldi 8:u16 @{out_dev}@";
    "add 8:u32 $arg 8";
    "ld 8:u32 8";
    "ldi 9:u16 1";
    "ldi 10:u16 @{c}@";
    "add 10:u32 $arg 10";
    "ld 10:u32 10";
    "ld 11:u8 10";
    "tz 11";
    "jmpri 16";
    "sav 8:u8 11";
    "add 10:u32 10 9";
    "jmpri -20";
    "popr $stat";
    "ret";
}
#endif
